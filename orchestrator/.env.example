# --- LLM (goal decomposition + specialist reasoning) ---
ANTHROPIC_API_KEY=
ORCHESTRATOR_MODEL=claude-sonnet-5

# --- CAP transport ---
# "mock" (default): in-memory CAP network, free/instant, no CROO account needed.
# "real": Base Mainnet via @croo-network/sdk. No testnet exists -- this moves real USDC.
CAP_MODE=mock

# Only used when CAP_MODE=real:
CROO_API_URL=https://api.croo.network
CROO_WS_URL=wss://api.croo.network/ws
BASE_RPC_URL=

# One CROO Agent (agent.croo.network) + API key per identity in the demo economy.
# Falls back to CROO_SDK_KEY if a specific one isn't set.
CROO_SDK_KEY=
ORCHESTRATOR_CROO_SDK_KEY=
RESEARCH_CROO_SDK_KEY=
RESEARCH_BACKUP_CROO_SDK_KEY=
VERIFY_CROO_SDK_KEY=
VERIFY_BACKUP_CROO_SDK_KEY=
CONTENT_CROO_SDK_KEY=
CONTENT_BACKUP_CROO_SDK_KEY=

# --- Hiring / failure handling ---
HIRE_TIMEOUT_MS=60000
POLL_INTERVAL_MS=500
MAX_RETRIES_PER_SUBTASK=1

# Demo/testing knobs:
# SIMULATE_FAILURES=true reserved for future random-failure injection.
SIMULATE_FAILURES=false
# Comma-separated agentIds (from registry.json) that silently ignore their
# first negotiation, to demonstrate the timeout+retry-with-different-agent
# path deterministically, e.g.:
# FORCE_FAIL_AGENTS=agent-research
FORCE_FAIL_AGENTS=
